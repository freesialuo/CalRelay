{
  "name": "calrelay-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "node scripts/local-preview.mjs",
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "npm run test:fixtures && npm run test:smoke && npm run test:components && npm run test:integration && npm run test:system && npm run test:system:clock",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:smoke": "playwright test",
    "test:components": "playwright test -c tests/component.config.ts",
    "test:integration": "node tests/support/build-harness.mjs && playwright test -c tests/integration.config.ts",
    "test:fixtures": "node --test tests/system/fixtures.test.mjs",
    "test:system:clock": "CALRELAY_TEST_CONTROLLED_CLOCK=1 npm run test:system",
    "test:system": "node tests/support/build-harness.mjs && playwright test -c tests/system.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
